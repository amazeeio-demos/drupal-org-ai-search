{
    "name": "amazeeio-demos/drupal-org-ai-search",
    "description": "Drupal AI Search demo (Umami RAG recipe-finder chatbot) on Lagoon.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "The Lagoon Authors",
            "homepage": "https://github.com/uselagoon",
            "email": "uselagoon@amazee.io"
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "amazeeio/drupal_integrations": "^0.5",
        "composer/installers": "^2",
        "cweagans/composer-patches": "^2",
        "drupal/ai": "^1.4",
        "drupal/ai_agents": "^1.3",
        "drupal/ai_provider_amazeeio_recipe": "^1.3",
        "drupal/ai_provider_litellm": "^1.0",
        "drupal/ai_provider_openai": "^1.0",
        "drupal/amazeeio_umami_search": "^1.3",
        "drupal/core-composer-scaffold": "^11.4",
        "drupal/core-project-message": "^11.4",
        "drupal/core-recommended": "^11.4",
        "drupal/lagoon_logs": "^3.0",
        "drush/drush": "^13",
        "league/commonmark": "^2.4"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "tbachert/spi": true
        },
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "drush/drush": {
                "Restore `drush recipe` with Drupal core >=11.4 (RecipeCommand moved to a new namespace)": "patches/drush-recipe-command-core-11.4.patch"
            },
            "drupal/amazeeio_umami_search": {
                "Apply over pre-existing config (strict: false); drop when >1.3.0 released": "patches/amazeeio_umami_search-strict-false.patch"
            }
        }
    }
}
