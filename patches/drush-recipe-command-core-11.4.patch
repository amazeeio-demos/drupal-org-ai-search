Restore the drush recipe command on Drupal core >= 11.4.

Core 11.4 moved RecipeCommand to Drupal\Core\Recipe\Command\RecipeCommand
and exposes it through the console.command_loader service, so Drush's
class_exists() check on the old FQCN silently drops the command.

--- a/src/Runtime/ServiceManager.php	2026-07-06 22:28:13
+++ b/src/Runtime/ServiceManager.php	2026-07-06 22:28:13
@@ -360,6 +360,16 @@
             $instance = new RecipeCommand($this->autoloader);
             $instance->setHelp('See https://drupal.org/project/issues/drupal for bug reports and feature requests for this command.');
             $instances[] = $instance;
+        }
+        // Drupal core 11.4 moved RecipeCommand to a new namespace and exposes
+        // it through the console.command_loader service instead.
+        elseif (class_exists(\Drupal\Core\Recipe\Command\RecipeCommand::class) && \Drupal::hasContainer() && \Drupal::getContainer()->has('console.command_loader')) {
+            $loader = \Drupal::service('console.command_loader');
+            if ($loader->has('recipe')) {
+                $instance = $loader->get('recipe');
+                $instance->setHelp('See https://drupal.org/project/issues/drupal for bug reports and feature requests for this command.');
+                $instances[] = $instance;
+            }
         }
 
         return $instances;
