# Local project name - setting this here aligns container names with routes
COMPOSE_PROJECT_NAME=polydock-ai-trial-drupal-cms-search

# amazee.ai LLM API
AI_LLM_API_URL="https://litellm.amazeeai-something.amazeeio.something"
AI_LLM_API_TOKEN="sk-somekeysomekey"

# amazee.ai external Postgres/pgvector database (vector store)
AI_DB_HOST_NAME="amazeeio-ai-demo.cluster-something.eu-central-2.rds.amazonaws.com"
AI_DB_NAME="db_something"
AI_DB_USERNAME="user_someone"
AI_DB_PASSWORD="somepass"
